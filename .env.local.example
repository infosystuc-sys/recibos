# Supabase — panel del proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://twejfeghrujsqzzuzvtf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio del email sintético con el que los empleados entran por CUIL.
# No necesita existir: nunca se le envía correo.
EMPLEADO_EMAIL_DOMAIN=empleados.conforme.local

# Credenciales del administrador usadas por las pruebas E2E.
# Si faltan, el caso "permite ingresar con el administrador de prueba" se saltea.
ADMIN_EMAIL_PRUEBA=
ADMIN_CLAVE_PRUEBA=

# ── Fase 2 — notificaciones (todo opcional; si falta, el canal queda inactivo) ──

# URL pública de la app, para armar los enlaces de los avisos.
APP_URL=http://localhost:3000

# Protege /api/cron/notificaciones. Vercel Cron manda "Authorization: Bearer <esto>".
# Generar: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Email (Resend). El dominio de EMAIL_FROM debe estar verificado en Resend (SPF/DKIM).
RESEND_API_KEY=
EMAIL_FROM="Conforme <avisos@tu-dominio.com>"

# Web Push (VAPID). Generar el par: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tu-dominio.com

# WhatsApp vía Evolution API (self-hosted). Ausente = canal deshabilitado.
# La instancia tiene que estar vinculada a un teléfono (escanear el QR en el
# manager de Evolution API). Ver docs/EVOLUTION-API.md.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_PAIS=54
